# VoxVision AI Backend Environment Variables

# Application Settings
APP_NAME="VoxVision AI"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# CORS Settings
ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000"

# LLM Settings (groq, gemini, openai, or mock)
LLM_PROVIDER="groq"
LLM_MODEL_NAME="openai/gpt-oss-120b"

# AI Provider API Keys (Stored ONLY on backend - NEVER exposed to frontend)
GROQ_API_KEY="your_groq_api_key_here"
# GEMINI_API_KEY="your_gemini_api_key_here"
# OPENAI_API_KEY="your_openai_api_key_here"
